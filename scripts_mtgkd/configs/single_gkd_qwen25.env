# Single-teacher GKD, Qwen2.5-1.5B (Table 2 setup).
# Sourced by qwen25_single_teacher_gkd_domain.sbatch; values here override the sbatch defaults.
# Each line keeps an already-set environment variable, so a value passed at submit time still wins.

# Outputs: one folder per run under /mnt/scratch-artemis/margot/mtgkd/runs/ (pass RUN_ROOT at submit time).

# Student initialisation. TODO: set the real path to qwen25_1p5b_base_sft_selected_all_66666.
export BASE_MODEL="${BASE_MODEL:-/path/to/qwen25_1p5b_base_sft_selected_all_66666}"

# Batch: 2 GPUs (set in #SBATCH --gres) x 1 x 16 = 32 examples per optimizer step.
export PER_DEVICE_TRAIN_BATCH_SIZE="${PER_DEVICE_TRAIN_BATCH_SIZE:-1}"
export PER_DEVICE_EVAL_BATCH_SIZE="${PER_DEVICE_EVAL_BATCH_SIZE:-1}"
export GRADIENT_ACCUMULATION_STEPS="${GRADIENT_ACCUMULATION_STEPS:-16}"

# Optimisation.
export LEARNING_RATE="${LEARNING_RATE:-5e-6}"
export OPTIM="${OPTIM:-adamw_torch}"
export LR_SCHEDULER_TYPE="${LR_SCHEDULER_TYPE:-cosine}"
export WARMUP_RATIO="${WARMUP_RATIO:-0.03}"
export MAX_GRAD_NORM="${MAX_GRAD_NORM:-1.0}"
export WEIGHT_DECAY="${WEIGHT_DECAY:-0.0}"
export NUM_TRAIN_EPOCHS="${NUM_TRAIN_EPOCHS:-1}"
export MAX_STEPS="${MAX_STEPS:--1}"

# Lengths.
export MAX_LENGTH="${MAX_LENGTH:-1024}"
export MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-256}"

# GKD.
export BETA="${BETA:-0.5}"
export TEMPERATURE="${TEMPERATURE:-0.9}"
export SEQ_KD="${SEQ_KD:-False}"
# LMBDA is not fixed by the table; pass it per run (sbatch default: 0.5).

# Reproducibility and precision: bf16 loading for student and teacher, bf16 mixed precision.
export SEED="${SEED:-42}"
export USE_BF16="${USE_BF16:-True}"
